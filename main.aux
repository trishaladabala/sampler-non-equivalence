\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The ``Same Frontier, Different Text'' paradox on ELF-B (pilot seeds $201\text  {--}205$, paired CRN $df=4$; replication seeds $401\text  {--}420$, paired CRN $df=19$, $M=1{,}000$/seed; all error bars on observed shifts plot seed-level paired CRN 95\% CIs $d_s = Y_{B,s} - Y_{A,s}$). \textbf  {(a)} Primary Equivalence: \textbf  {C1}--\textbf  {C3} pass Tier-I Joint TOST ($\pm 2.5\%$ Gen-PPL, $\pm 0.015$ nats $H_{\mathrm  {ps}}$; $p_{\mathrm  {Holm}} \le 0.0030$ pilot, $\le 3.40\times 10^{-8}$ replication). \textbf  {(b)} Secondary Divergence: $9/9$ Family 2 tests pass step-down Holm ($p_{\mathrm  {Holm}} \le 5.13\times 10^{-12}$ on 20-seed replication). \textbf  {(c)} Out-of-Sample Iso-Frontier Line-Integral Validation: Stage-1 predictions $\Delta _{\mathrm  {pred}} = \DOTSI \intop \ilimits@ _{\mathcal  {C}} \kappa _m\,d\ell $ (open diamonds: seeds $0\text  {--}1$ with $B=500$ bootstrap 95\% CIs over 2 seeds/cell for \texttt  {rep-4}; 40-run Stage-1 response surface across 11 operating points, seeds $0\text  {--}4$, quadratic $R^2=0.980$ with residual SD for $\mathrm  {JSD}_\pi $) vs.\ 5-seed pilot (circles) and 20-seed replication (squares) shifts ($+2.5\%\text  {--}+5.1\%$ error on \texttt  {rep-4}, $-6.1\%\text  {--}-6.7\%$ on $\mathrm  {JSD}_\pi $; nonlinear MAUVE exhibits $+66.0\%$ curvature error on C3, Table~\ref {tab:iso_frontier_validation}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:teaser}{{1}{2}{The ``Same Frontier, Different Text'' paradox on ELF-B (pilot seeds $201\text {--}205$, paired CRN $df=4$; replication seeds $401\text {--}420$, paired CRN $df=19$, $M=1{,}000$/seed; all error bars on observed shifts plot seed-level paired CRN 95\% CIs $d_s = Y_{B,s} - Y_{A,s}$). \textbf {(a)} Primary Equivalence: \textbf {C1}--\textbf {C3} pass Tier-I Joint TOST ($\pm 2.5\%$ Gen-PPL, $\pm 0.015$ nats $H_{\mathrm {ps}}$; $p_{\mathrm {Holm}} \le 0.0030$ pilot, $\le 3.40\times 10^{-8}$ replication). \textbf {(b)} Secondary Divergence: $9/9$ Family 2 tests pass step-down Holm ($p_{\mathrm {Holm}} \le 5.13\times 10^{-12}$ on 20-seed replication). \textbf {(c)} Out-of-Sample Iso-Frontier Line-Integral Validation: Stage-1 predictions $\Delta _{\mathrm {pred}} = \int _{\mathcal {C}} \kappa _m\,d\ell $ (open diamonds: seeds $0\text {--}1$ with $B=500$ bootstrap 95\% CIs over 2 seeds/cell for \texttt {rep-4}; 40-run Stage-1 response surface across 11 operating points, seeds $0\text {--}4$, quadratic $R^2=0.980$ with residual SD for $\mathrm {JSD}_\pi $) vs.\ 5-seed pilot (circles) and 20-seed replication (squares) shifts ($+2.5\%\text {--}+5.1\%$ error on \texttt {rep-4}, $-6.1\%\text {--}-6.7\%$ on $\mathrm {JSD}_\pi $; nonlinear MAUVE exhibits $+66.0\%$ curvature error on C3, Table~\ref {tab:iso_frontier_validation})}{figure.caption.1}{}}
